{
	"$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNamespace": "error",
				"useAsConstAssertion": "error",
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "enumMember"
								},
								"formats": ["CONSTANT_CASE", "camelCase"]
							},
							{
								"selector": {
									"modifiers": ["private"],
									"kind": "classMember"
								},
								"match": "_(.+)"
							},

							{
								"selector": {
									"modifiers": ["protected"],
									"kind": "classMember"
								},
								"match": ".*"
							},
							{
								"selector": {
									"kind": "classMember"
								},
								"match": "[^_].*"
							},
							{
								"selector": {
									"modifiers": ["readonly", "static"],
									"kind": "classProperty"
								},
								"formats": ["CONSTANT_CASE"]
							},
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"match": ".*"
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
