	"module": "index.ts",
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@types/bun": "latest",
		"@types/microtime": "^2.1.2"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"scripts": {
		"dev": "DEBUG=true bun run src/index.ts",
