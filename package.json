{
  "name": "viewfinder",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run index.ts",
    "demo": "bun run index.ts",
    "test": "bun run test-runner.ts",
    "benchmark": "bun run -e \"import('./index.js').then(m => m.runQuickBenchmark())\"",
    "benchmark-full": "bun run -e \"import('./index.js').then(m => m.runFullBenchmarkSuite())\"",
    "stress-test": "bun run -e \"import('./test-runner.js').then(m => { const t = new m.TestRunner(); return t.runStressTests(); })\"",
    "server": "bun run websocket-server.ts",
    "network-test": "bun run network-benchmark.ts",
    "multi-client": "bun run multi-client-test.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/bun": "latest",
    "@types/ws": "^8.5.10"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
